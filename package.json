{
  "name": "private-eye",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private Eye — privacy-preserving OCR. Digitize PDFs/images into structured Markdown entirely in the browser. Nothing is uploaded.",
  "license": "MIT",
  "homepage": "https://github.com/jeyabbalas/private-eye",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/setup-esbuild-shim.mjs",
    "dev": "node --experimental-strip-types scripts/prepare-build.ts && vite",
    "build": "node --experimental-strip-types scripts/prepare-build.ts && vite build",
    "preview": "vite preview",
    "fetch-models": "node --experimental-strip-types scripts/fetch-models.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ocr:harness": "node --experimental-strip-types scripts/ocr-harness.ts",
    "calibrate": "node --experimental-strip-types scripts/calibrate-uncertainty.ts"
  },
  "dependencies": {
    "@wllama/wllama": "3.5.0",
    "fastest-levenshtein": "^1.0.16",
    "fflate": "^0.8.2",
    "idb": "^8.0.0",
    "js-yaml": "^4.1.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "onnxruntime-common": "1.26.0",
    "onnxruntime-web": "1.26.0",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@types/diff": "^7.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "diff": "^7.0.0",
    "esbuild-wasm": "0.25.12",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "esbuild": "npm:esbuild-wasm@0.25.12"
  }
}
